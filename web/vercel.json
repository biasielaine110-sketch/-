{
  "framework": "vite",
  "installCommand": "npm install --legacy-peer-deps --force",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/proxy.js": {
      "maxDuration": 300,
      "memory": 1024
    },
    "api/canvas-bridge/[...path].js": {
      "maxDuration": 300,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
